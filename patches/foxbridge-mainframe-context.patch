 // latestContextForSession returns the most recent Juggler execution context for a CDP session.
+// Chrome-compatible semantics: when the client evaluates without an explicit
+// contextId, use the MAIN-FRAME context (falling back to the latest one), so
+// ad/embed iframes created after page load never hijack context-less evaluates.
 func (b *Bridge) latestContextForSession(cdpSessionID string) string {
 	jugglerSessionID := b.resolveSession(cdpSessionID)
 	b.latestCtxMu.RLock()
 	defer b.latestCtxMu.RUnlock()
+	if id := b.mainCtx[jugglerSessionID]; id != "" {
+		return id
+	}
 	return b.latestCtx[jugglerSessionID]
 }
 
diff --git a/pkg/bridge/events.go b/pkg/bridge/events.go
