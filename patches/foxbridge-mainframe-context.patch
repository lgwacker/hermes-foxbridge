@@ -425,6 +425,12 @@ func (b *Bridge) SetupEventSubscriptions() {
 		// during navigation — only the last surviving one matters.
 		b.latestCtxMu.Lock()
 		b.latestCtx[jugglerSessionID] = ev.ExecutionContextID
+		// Also track the main-frame context: context-less Runtime.evaluate
+		// must target the top frame (Chrome semantics), not the last ad
+		// iframe context created after the page finished loading.
+		if strings.HasPrefix(ev.AuxData.FrameID, "mainframe") {
+			b.mainCtx[jugglerSessionID] = ev.ExecutionContextID
+		}
 		b.latestCtxMu.Unlock()
 
 		cdpFrameID := b.cdpFrameIDForJugglerSession(jugglerSessionID, ev.AuxData.FrameID)
