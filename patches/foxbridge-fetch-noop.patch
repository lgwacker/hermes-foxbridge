+// globMatch reports whether url matches a CDP urlPattern glob ('*' matches
+// any sequence of characters). Used to honor Fetch.enable patterns: requests
+// outside every pattern are auto-continued instead of paused.
+func globMatch(pattern, url string) bool {
+	var sb strings.Builder
+	sb.WriteString("(?i)^")
+	for _, r := range pattern {
+		if r == '*' {
+			sb.WriteString(".*")
+		} else {
+			sb.WriteString(regexp.QuoteMeta(string(r)))
+		}
+	}
+	sb.WriteString("$")
+	re, err := regexp.Compile(sb.String())
+	if err != nil {
+		return false
+	}
+	return re.MatchString(url)
+}
